    # Camera Methods
    def toggle_camera(self):
        """Start or stop the camera"""
        if not self.camera_active:
            self.start_camera()
        else:
            self.stop_camera()
    
    def start_camera(self):
        """Start the camera feed"""
        try:
            self.cap = cv2.VideoCapture(0)
            if not self.cap.isOpened():
                raise Exception("Cannot open camera")
            
            self.camera_active = True
            self.camera_toggle_btn.configure(text="STOP CAMERA", bg=self.colors['accent_red'])
            self.camera_status.configure(text="Camera: ON", fg=self.colors['success'])
            
            # Clear the canvas text
            self.camera_canvas.delete("camera_text")
            
            self.update_camera_feed()
            self.add_log("Camera activated successfully", "SUCCESS")
            
        except Exception as e:
            self.add_log(f"Camera error: {str(e)}", "ERROR")
            self.camera_canvas.delete("all")
            self.camera_canvas.create_text(400, 300, 
                                         text=f"Camera Error: {str(e)}",
                                         fill=self.colors['error'],
                                         font=self.fonts['subtitle'],
                                         tags="camera_text")
            self.show_modern_error("Camera Error", f"Cannot access camera: {str(e)}")
    
    def stop_camera(self):
        """Stop the camera feed"""
        self.camera_active = False
        
        if hasattr(self, 'cap') and self.cap:
            self.cap.release()
        
        self.camera_toggle_btn.configure(text="START CAMERA", bg=self.colors['accent_green'])
        self.camera_status.configure(text="Camera: OFF", fg=self.colors['text_muted'])
        
        # Clear canvas and show stopped message
        self.camera_canvas.delete("all")
        self.camera_canvas.create_text(400, 300, 
                                     text="Camera Stopped - Click 'Start Camera' to resume",
                                     fill=self.colors['text_secondary'],
                                     font=self.fonts['subtitle'],
                                     tags="camera_text")
        
        self.add_log("Camera stopped", "INFO")
    
    def update_camera_feed(self):
        """Update the camera feed - ALWAYS 800x600 size"""
        if self.camera_active and self.cap and self.cap.isOpened():
            ret, frame = self.cap.read()
            if ret:
                # Flip for mirror effect
                frame = cv2.flip(frame, 1)
                frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                
                # FORCE resize to exactly 800x600 - no dynamic sizing
                frame_resized = cv2.resize(frame_rgb, (800, 600))
                
                # Convert to PIL/Tkinter format
                pil_image = Image.fromarray(frame_resized)
                self.photo = ImageTk.PhotoImage(pil_image)
                
                # Clear canvas and display image at center
                self.camera_canvas.delete("all")
                self.camera_canvas.create_image(400, 300, image=self.photo)
            
            # Schedule next update
            if self.camera_active:
                self.root.after(30, self.update_camera_feed)
    
    def capture_current_frame(self):
        """Capture the current camera frame"""
        if self.cap and self.cap.isOpened():
            ret, frame = self.cap.read()
            if ret:
                return frame
        return None
    
    # API Methods (modernized)
    def register_face_threaded(self):
        threading.Thread(target=self.register_face, daemon=True).start()
    
    def pointage_threaded(self):
        threading.Thread(target=self.pointage, daemon=True).start()
    
    def register_face(self):
        """Modern face registration with enhanced UX"""
        worker_id = self.entry_id.get().strip()
        worker_name = self.entry_name.get().strip()
        
        if not worker_id:
            self.show_modern_error("Employee ID Required", "Please enter a valid employee ID")
            return
        
        if not self.camera_active:
            self.show_modern_error("Camera Not Active", "Please start the camera first before registering")
            return
        
        self.status_var.set("Processing Registration...")
        self.add_log(f"Starting face registration for ID: {worker_id}", "INFO")
        
        # Capture current frame
        frame = self.capture_current_frame()
        if frame is not None:
            try:
                # Save image temporarily
                temp_image_path = f"temp_registration_{worker_id}.jpg"
                cv2.imwrite(temp_image_path, frame)
                
                # Send request to backend
                data = {"ID_OUVRIER": worker_id}
                if worker_name:
                    data["NOM"] = worker_name
                
                response = requests.post(f"{BASE_URL}/register_face", json=data, timeout=30)
                
                if response.status_code == 200:
                    result = response.json()
                    self.add_log(f"Registration successful for {worker_id}", "SUCCESS")
                    self.show_modern_success("Registration Complete!", 
                                            f"Employee {worker_id} registered successfully!")
                    self.status_var.set("Registration Complete")
                    self.clear_fields()
                else:
                    self.add_log(f"Registration failed: {response.status_code}", "ERROR")
                    self.show_modern_error("Registration Failed", f"Server error: {response.status_code}")
                    self.status_var.set("Registration Failed")
                    
            except Exception as e:
                self.add_log(f"Registration error: {str(e)}", "ERROR")
                self.show_modern_error("Registration Error", str(e))
                self.status_var.set("Registration Error")
        else:
            self.show_modern_error("Capture Failed", "Unable to capture image from camera")
    
    def pointage(self):
        """Modern attendance checking"""
        if not self.camera_active:
            self.show_modern_error("Camera Not Active", "Please start the camera first before checking attendance")
            return
        
        self.status_var.set("Processing Attendance...")
        self.add_log("Starting attendance verification", "INFO")
        
        # Capture current frame
        frame = self.capture_current_frame()
        if frame is not None:
            try:
                # Save image temporarily
                temp_image_path = "temp_verification.jpg"
                cv2.imwrite(temp_image_path, frame)
                
                response = requests.get(f"{BASE_URL}/pointage", timeout=30)
                
                if response.status_code == 200:
                    result = response.json()
                    self.add_log("Attendance check completed", "SUCCESS")
                    self.show_modern_success("Attendance Verified!", 
                                            f"Result: {json.dumps(result, indent=2, ensure_ascii=False)}")
                    self.status_var.set("Attendance Complete")
                else:
                    self.add_log(f"Attendance check failed: {response.status_code}", "ERROR")
                    self.show_modern_error("Attendance Failed", f"Server error: {response.status_code}")
                    self.status_var.set("Attendance Failed")
                    
            except Exception as e:
                self.add_log(f"Attendance error: {str(e)}", "ERROR")
                self.show_modern_error("Attendance Error", str(e))
                self.status_var.set("Attendance Error")
        else:
            self.show_modern_error("Capture Failed", "Unable to capture image from camera")
    
    def clear_fields(self):
        """Clear all input fields with animation"""
        self.entry_id.delete(0, tk.END)
        self.entry_name.delete(0, tk.END)
        self.add_log("Input fields cleared", "INFO")
        self.status_var.set("System Ready")
    
    def show_modern_success(self, title, message):
        """Show modern success dialog"""
        messagebox.showinfo(f"✅ {title}", message)
    
    def show_modern_error(self, title, message):
        """Show modern error dialog"""
        messagebox.showerror(f"❌ {title}", message)
    
    def show_modern_info(self, title, message):
        """Show modern info dialog"""
        messagebox.showinfo(f"ℹ️ {title}", message)

def main():
    """Launch the ultra-modern application"""
    try:
        root = tk.Tk()
        app = ModernFacialRecognitionApp(root)
        
        # Modern keyboard shortcuts
        root.bind('<Control-r>', lambda e: app.register_face_threaded())
        root.bind('<Control-p>', lambda e: app.pointage_threaded())
        root.bind('<Control-d>', lambda e: app.clear_fields())
        
        root.mainloop()
    except KeyboardInterrupt:
        print("Application terminated by user")
    except Exception as e:
        print(f"Error starting application: {e}")

if __name__ == "__main__":
    main()